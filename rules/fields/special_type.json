{
  "version": 1,
  "purpose": "识别出现在正常内容编号位置的特殊内容类型；顺序即优先级。",
  "types": [
    {"type": "NCOP_ED", "regex": "(?i)^NCOP[_ -]?ED(?:[_ -]?(?P<number>\\d{1,3}))?$"},
    {"type": "NCOP", "regex": "(?i)^NCOP(?:[_ -]?(?P<number>\\d{1,3}))?$"},
    {"type": "NCED", "regex": "(?i)^NCED(?:[_ -]?(?P<number>\\d{1,3}))?$"},
    {"type": "OPED", "regex": "(?i)^OP[_ -]?ED(?:[_ -]?(?P<number>\\d{1,3}))?$"},
    {"type": "SP", "regex": "(?i)^00[& _-]*SP(?:[_ -]?(?P<number>\\d{1,3}))?(?:\\s+.*)?$"},
    {"type": "TOKUTEN", "regex": "(?i)^(?:TOKUTEN|特典)(?:\\s*(?P<number>\\d{1,3}))?(?:\\s+.*)?$"},
    {"type": "OVA", "regex": "(?i)^OVA(?:[_ -]?(?P<number>\\d{1,3}))?(?:\\s+.*)?$"},
    {"type": "SP", "regex": "(?i)^SP(?:[_ -]?(?P<number>\\d{1,3}))?(?:\\s+.*)?$"},
    {"type": "MENU", "regex": "(?i)^MENU(?:[_ -]?(?P<number>\\d{1,3}))?(?:\\s+.*)?$"},
    {"type": "PV", "regex": "(?i)^PV(?:[_ -]?(?P<number>\\d{1,3}))?(?:\\s+.*)?$"},
    {"type": "OP", "regex": "(?i)^OP(?:[_ -]?(?P<number>\\d{1,3}))?(?:\\s+.*)?$"},
    {"type": "ED", "regex": "(?i)^ED(?:[_ -]?(?P<number>\\d{1,3}))?(?:\\s+.*)?$"}
  ]
}
